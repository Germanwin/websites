			"head": 20,
			"layer": 4
		},
		"mels": 128,
		"ftype": 1
	},
	"params": {
		"model": "models/ggml-large-v3-turbo.bin",
		"language": "ru",
		"translate": false
	},
	"result": {
		"language": "ru"
	},
	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:01,540"
			},
			"offsets": {
				"from": 0,
				"to": 1540
			},
			"text": " Этот урок будет посвящен маркировке рекламы."
		},
		{
			"timestamps": {
				"from": "00:00:01,640",
				"to": "00:00:03,260"
			},
			"offsets": {
				"from": 1640,
				"to": 3260
			},
			"text": " В нем будет 3 видео, и сперва мы поговорим, что такое реклама,"
		},
		{
			"timestamps": {
				"from": "00:00:03,600",
				"to": "00:00:05,440"
			},
			"offsets": {
				"from": 3600,
				"to": 5440
			},
			"text": " что такое маркировка рекламы, где надо и не надо маркировать рекламу,"
		},
		{
			"timestamps": {
				"from": "00:00:05,520",
				"to": "00:00:07,440"
			},
			"offsets": {
				"from": 5520,
				"to": 7440
			},
			"text": " как правильно маркировать рекламу и что будет, если этого не делать."
		},
		{
			"timestamps": {
				"from": "00:00:07,680",
				"to": "00:00:10,040"
			},
			"offsets": {
				"from": 7680,
				"to": 10040
			},
			"text": " А затем посмотрим порядок маркировки рекламы и в завершении обсудим отсчет рекламной кампании."
		},
		{
			"timestamps": {
				"from": "00:00:10,180",
				"to": "00:00:11,120"
			},
			"offsets": {
				"from": 10180,
				"to": 11120
			},
			"text": " Итак, что такое реклама?"
		},
		{
			"timestamps": {
				"from": "00:00:11,400",
				"to": "00:00:13,280"
			},
			"offsets": {
				"from": 11400,
				"to": 13280
			},
			"text": " Определение мы с вами будем брать прямо из закона о рекламе,"
		},
		{
			"timestamps": {
				"from": "00:00:13,540",
				"to": "00:00:15,420"
			},
			"offsets": {
				"from": 13540,
				"to": 15420
			},
			"text": " где указано, что реклама — это, в первую очередь, информация,"
		},
		{
			"timestamps": {
				"from": "00:00:15,720",
				"to": "00:00:18,480"
			},
			"offsets": {
				"from": 15720,
				"to": 18480
			},
			"text": " распространенная любым способом, в любой форме и с использованием любых средств,"
		},
		{
			"timestamps": {
				"from": "00:00:18,640",
				"to": "00:00:21,620"
			},
			"offsets": {
				"from": 18640,
				"to": 21620
			},
			"text": " адресованная неопределённому кругу лиц и направленная на привлечение внимания к объекту рекламирования,"
		},
		{
			"timestamps": {
				"from": "00:00:21,780",
				"to": "00:00:23,680"
			},
			"offsets": {
				"from": 21780,
				"to": 23680
			},
			"text": " формирование или поддержание интереса к нему и его продвижения на рынке."
		},
		{
			"timestamps": {
				"from": "00:00:23,760",
				"to": "00:00:25,440"
			},
			"offsets": {
				"from": 23760,
				"to": 25440
			},
			"text": " Сразу отметим на частые вопросы, которые тут возникают."
		},
		{
			"timestamps": {
				"from": "00:00:25,620",
				"to": "00:00:26,800"
			},
			"offsets": {
				"from": 25620,
				"to": 26800
			},
			"text": " Во-первых, цель рекламы – привлечь внимание."
		},
		{
			"timestamps": {
				"from": "00:00:27,260",
				"to": "00:00:28,560"
			},
			"offsets": {
				"from": 27260,
				"to": 28560
			},
			"text": " Во-вторых, неважно, где вы её распространяете."
		},
		{
			"timestamps": {
				"from": "00:00:28,660",
				"to": "00:00:30,420"
			},
			"offsets": {
				"from": 28660,
				"to": 30420
			},
			"text": " На смене места распространения рекламы она не пристрелит рекламой,"
		},
		{
			"timestamps": {
				"from": "00:00:30,460",
				"to": "00:00:31,700"
			},
			"offsets": {
				"from": 30460,
				"to": 31700
			},
			"text": " хоть в Телеграме, хоть в Инстаграме, хоть в Инстаграме, хоть в Инстаграме, но нет."
		},
		{
			"timestamps": {
				"from": "00:00:31,980",
				"to": "00:00:32,660"
			},
			"offsets": {
				"from": 31980,
				"to": 32660
			},
			"text": " Реклама – она и в Африке рекламы."
		},
		{
			"timestamps": {
				"from": "00:00:32,860",
				"to": "00:00:32,860"
			},
			"offsets": {
				"from": 32860,
				"to": 32860
			},
			"text": " В-третьих, рекламировать можно что угодно – товар, услугу, компанию, мероп"
		},
		{
			"timestamps": {
				"from": "00:00:32,860",
				"to": "00:00:36,500"
			},
			"offsets": {
				"from": 32860,
				"to": 36500
			},
			"text": " В-третьих, рекламировать можно что угодно – товар, услугу, компанию, мероприятие, событие и так далее."
		},
		{
			"timestamps": {
				"from": "00:00:36,820",
				"to": "00:00:38,340"
			},
			"offsets": {
				"from": 36820,
				"to": 38340
			},
			"text": " И четвёртая – реклама всегда является информацией."
		},
		{
			"timestamps": {
				"from": "00:00:38,420",
				"to": "00:00:39,900"
			},
			"offsets": {
				"from": 38420,
				"to": 39900
			},
			"text": " Какие-то действия не могут быть признаны рекламой."
		},
		{
			"timestamps": {
				"from": "00:00:40,060",
				"to": "00:00:42,460"
			},
			"offsets": {
				"from": 40060,
				"to": 42460
			},
			"text": " Только информация, которая выражается в форме текста, видео, аудио и тому подобное."
		},
		{
			"timestamps": {
				"from": "00:00:42,780",
				"to": "00:00:44,400"
			},
			"offsets": {
				"from": 42780,
				"to": 44400
			},
			"text": " Поскольку тема урока посвящена маркировке рекламы,"
		},
		{
			"timestamps": {
				"from": "00:00:44,420",
				"to": "00:00:45,640"
			},
			"offsets": {
				"from": 44420,
				"to": 45640
			},
			"text": " то мы сразу же ограничим предмет наше изучение."
		},
		{
			"timestamps": {
				"from": "00:00:45,700",
				"to": "00:00:47,500"
			},
			"offsets": {
				"from": 45700,
				"to": 47500
			},
			"text": " Обязательно маркировка предусмотрена только для рекламы,"
		},
		{
			"timestamps": {
				"from": "00:00:47,500",
				"to": "00:00:48,560"
			},
			"offsets": {
				"from": 47500,
				"to": 48560
			},
			"text": " которая распространяется в сети интернет."
		},
		{
			"timestamps": {
				"from": "00:00:48,760",
				"to": "00:00:51,740"
			},
			"offsets": {
				"from": 48760,
				"to": 51740
			},
			"text": " Поэтому у нас и будет интересовать только рекламу в сетях, на сайтах, приложениях и иных местах,"
		},
		{
			"timestamps": {
				"from": "00:00:51,820",
				"to": "00:00:53,500"
			},
			"offsets": {
				"from": 51820,
				"to": 53500
			},
			"text": " доступ в который мы можем обеспечить исключительно через интернет."
		},
		{
			"timestamps": {
				"from": "00:00:53,680",
				"to": "00:00:55,600"
			},
			"offsets": {
				"from": 53680,
				"to": 55600
			},
			"text": " Причём мы не рассматриваем таргетированную рекламу, так как она маркируется автоматически."
		},
		{
			"timestamps": {
				"from": "00:00:55,680",
				"to": "00:00:56,920"
			},
			"offsets": {
				"from": 55680,
				"to": 56920
			},
			"text": " Мы говорим про рекламу блогеров и публиков."
		},
		{
			"timestamps": {
				"from": "00:00:57,180",
				"to": "00:00:57,740"
			},
			"offsets": {
				"from": 57180,
				"to": 57740
			},
			"text": " Теперь самое интересное."
		},
		{
			"timestamps": {
				"from": "00:00:57,940",
				"to": "00:00:59,600"
			},
			"offsets": {
				"from": 57940,
				"to": 59600
			},
			"text": " По закону вы можете рекламировать как чужие товары, так и свои."
		},
		{
			"timestamps": {
				"from": "00:00:59,700",
				"to": "00:01:02,440"
			},
			"offsets": {
				"from": 59700,
				"to": 62440
			},
			"text": " Но не все ваши услуги будут признаваться рекламой, если вы о них рассказываете на своих сайтах."
		},
		{
			"timestamps": {
				"from": "00:01:02,500",
				"to": "00:01:03,980"
			},
			"offsets": {
				"from": 62500,
				"to": 63980
			},
			"text": " Как понять, что является рекламой и что нет?"
		},
		{
			"timestamps": {
				"from": "00:01:04,140",
				"to": "00:01:05,580"
			},
			"offsets": {
				"from": 64140,
				"to": 65580
			},
			"text": " Мне нравится проводить примеры антимонопольной службы про витрину."
		},
		{
			"timestamps": {
				"from": "00:01:05,840",
				"to": "00:01:08,080"
			},
			"offsets": {
				"from": 65840,
				"to": 68080
			},
			"text": " Представьте, что вы заходите в хлебный магазин, где на витрине лежит 5 разных видов хлеба."
		},
		{
			"timestamps": {
				"from": "00:01:08,160",
				"to": "00:01:09,540"
			},
			"offsets": {
				"from": 68160,
				"to": 69540
			},
			"text": " Все они имеют свои особенности и разные по стоимости."
		},
		{
			"timestamps": {
				"from": "00:01:09,860",
				"to": "00:01:11,940"
			},
			"offsets": {
				"from": 69860,
				"to": 71940
			},
			"text": " Когда вы будете делать выбор, то ваш выбор, скорее всего, будет зависеть только от вас."
		},
		{
			"timestamps": {
				"from": "00:01:12,100",
				"to": "00:01:14,780"
			},
			"offsets": {
				"from": 72100,
				"to": 74780
			},
			"text": " Но в один день вы зашли в ту же лавку и видите, что напротив одного из хлебов висит огромная красная стрелка"
		},
		{
			"timestamps": {
				"from": "00:01:14,780",
				"to": "00:01:16,840"
			},
			"offsets": {
				"from": 74780,
				"to": 76840
			},
			"text": " и светится моргая надпись «Скидка 20%»."
		},
		{
			"timestamps": {
				"from": "00:01:16,840",
				"to": "00:01:20,340"
			},
			"offsets": {
				"from": 76840,
				"to": 80340
			},
			"text": " Добавлен триггер по времени только сегодня, и он специально подсвечен так, что остальные виды хлеба на его фоне просто блег."
		},
		{
			"timestamps": {
				"from": "00:01:20,520",
				"to": "00:01:21,640"
			},
			"offsets": {
				"from": 80520,
				"to": 81640
			},
			"text": " Это всё сделано для привлечения вашего внимания."
		},
		{
			"timestamps": {
				"from": "00:01:21,840",
				"to": "00:01:24,740"
			},
			"offsets": {
				"from": 81840,
				"to": 84740
			},
			"text": " Таким же образом надо смотреть и на свою витрину, когда вы публикуете информацию о ваших товарах или услугах."
		},
		{
			"timestamps": {
				"from": "00:01:24,980",
				"to": "00:01:27,480"
			},
			"offsets": {
				"from": 84980,
				"to": 87480
			},
			"text": " Если ваша лента в социальных сетях или на сайте содержит информацию о скидках на услуги или товары,"
		},
		{
			"timestamps": {
				"from": "00:01:27,480",
				"to": "00:01:29,160"
			},
			"offsets": {
				"from": 87480,
				"to": 89160
			},
			"text": " и такая информация оформлена в том же стиле, что и весь сайт,"
		},
		{
			"timestamps": {
				"from": "00:01:29,360",
				"to": "00:01:30,460"
			},
			"offsets": {
				"from": 89360,
				"to": 90460
			},
			"text": " то говорить о привлечении внимания навряд ли можно."
		},
		{
			"timestamps": {
				"from": "00:01:30,600",
				"to": "00:01:32,620"
			},
			"offsets": {
				"from": 90600,
				"to": 92620
			},
			"text": " Особенно часто такой вопрос возникает при размещении баннера на главной странице сайта."
		},
		{
			"timestamps": {
				"from": "00:01:32,820",
				"to": "00:01:33,440"
			},
			"offsets": {
				"from": 92820,
				"to": 93440
			},
			"text": " Надо ли маркировать баннер?"
		},
		{
			"timestamps": {
				"from": "00:01:33,680",
				"to": "00:01:35,200"
			},
			"offsets": {
				"from": 93680,
				"to": 95200
			},
			"text": " Сам по себе баннер – это способ размещения рекламы."
		},
		{
			"timestamps": {
				"from": "00:01:35,260",
				"to": "00:01:37,540"
			},
			"offsets": {
				"from": 95260,
				"to": 97540
			},
			"text": " Но также баннер может быть информационным источником, не рекламного характера."
		},
		{
			"timestamps": {
				"from": "00:01:37,700",
				"to": "00:01:39,140"
			},
			"offsets": {
				"from": 97700,
				"to": 99140
			},
			"text": " Поэтому стоит уководствоваться именно указанным подходом."
		},
		{
			"timestamps": {
				"from": "00:01:39,340",
				"to": "00:01:41,120"
			},
			"offsets": {
				"from": 99340,
				"to": 101120
			},
			"text": " Есть ли у баннера факт привлечения внимания к объекту рекламирования?"
		},
		{
			"timestamps": {
				"from": "00:01:41,380",
				"to": "00:01:43,400"
			},
			"offsets": {
				"from": 101380,
				"to": 103400
			},
			"text": " Причем распространять данное правило надо только на свои товары и услуги."
		},
		{
			"timestamps": {
				"from": "00:01:43,400",
				"to": "00:01:45,280"
			},
			"offsets": {
				"from": 103400,
				"to": 105280
			},
			"text": " Если баннер содержит информацию о товарах или услугах третьих лиц,"
		},
		{
			"timestamps": {
				"from": "00:01:45,440",
				"to": "00:01:47,220"
			},
			"offsets": {
				"from": 105440,
				"to": 107220
			},
			"text": " то это, скорее всего, будет рекламой и подлежит обязательной маркировке."
		},
		{
			"timestamps": {
				"from": "00:01:47,480",
				"to": "00:01:48,380"
			},
			"offsets": {
				"from": 107480,
				"to": 108380
			},
			"text": " В рекламе есть как минимум два лица."
		},
		{
			"timestamps": {
				"from": "00:01:48,480",
				"to": "00:01:49,800"
			},
			"offsets": {
				"from": 108480,
				"to": 109800
			},
			"text": " Это рекламодатель и рекламораспространитель."
		},
		{
			"timestamps": {
				"from": "00:01:50,060",
				"to": "00:01:51,880"
			},
			"offsets": {
				"from": 110060,
				"to": 111880
			},
			"text": " Рекламодатель – это тот, чьи товары или услуги будут рекламироваться."
		},
		{
			"timestamps": {
				"from": "00:01:52,000",
				"to": "00:01:54,600"
			},
			"offsets": {
				"from": 112000,
				"to": 114600
			},
			"text": " А рекламораспространитель – это тот, кто размещает рекламу на своем ресурсе."
		},
		{
			"timestamps": {
				"from": "00:01:54,740",
				"to": "00:01:56,220"
			},
			"offsets": {
				"from": 114740,
				"to": 116220
			},
			"text": " Иногда между ними есть агенты, продюсеры или маркетологи,"
		},
		{
			"timestamps": {
				"from": "00:01:56,260",
				"to": "00:01:57,440"
			},
			"offsets": {
				"from": 116260,
				"to": 117440
			},
			"text": " которые тоже могут быть включены в рекламную цепочку."
		},
		{
			"timestamps": {
				"from": "00:01:57,700",
				"to": "00:01:59,100"
			},
			"offsets": {
				"from": 117700,
				"to": 119100
			},
			"text": " Теперь поговорим о том, что такое маркировка рекламы."
		},
		{
			"timestamps": {
				"from": "00:01:59,340",
				"to": "00:02:01,520"
			},
			"offsets": {
				"from": 119340,
				"to": 121520
			},
			"text": " Маркировка рекламы – это нанесение на рекламный криотик специального обозначения,"
		},
		{
			"timestamps": {
				"from": "00:02:01,520",
				"to": "00:02:03,820"
			},
			"offsets": {
				"from": 121520,
				"to": 123820
			},
			"text": " который подтверждает, что реклама учтена у оператора рекламных данных."
		},
		{
			"timestamps": {
				"from": "00:02:03,920",
				"to": "00:02:04,580"
			},
			"offsets": {
				"from": 123920,
				"to": 124580
			},
			"text": " Еще его называют ОРД."
		},
		{
			"timestamps": {
				"from": "00:02:04,940",
				"to": "00:02:06,440"
			},
			"offsets": {
				"from": 124940,
				"to": 126440
			},
			"text": " Маркировка рекламы состоит из самого слова «реклама»."
		},
		{
			"timestamps": {
				"from": "00:02:06,440",
				"to": "00:02:07,760"
			},
			"offsets": {
				"from": 126440,
				"to": 127760
			},
			"text": " Далее указывается рекламодатель, его именем,"
		},
		{
			"timestamps": {
				"from": "00:02:07,900",
				"to": "00:02:10,160"
			},
			"offsets": {
				"from": 127900,
				"to": 130160
			},
			"text": " после чего размещается рекламный токен, и это все является маркировка рекламы."
		},
		{
			"timestamps": {
				"from": "00:02:10,320",
				"to": "00:02:12,580"
			},
			"offsets": {
				"from": 130320,
				"to": 132580
			},
			"text": " И вот тут пришло время посмотреть, что такое рекламный токен и как его получать."
		},
		{
			"timestamps": {
				"from": "00:02:12,760",
				"to": "00:02:14,840"
			},
			"offsets": {
				"from": 132760,
				"to": 134840
			},
			"text": " И прежде чем мы перейдем к следующему видео, сделаем небольшое вступление."
		},
		{
			"timestamps": {
				"from": "00:02:14,940",
				"to": "00:02:17,140"
			},
			"offsets": {
				"from": 134940,
				"to": 137140
			},
			"text": " Во-первых, в рекламных договорах стороны всегда являются предпринимателями."
		},
		{
			"timestamps": {
				"from": "00:02:17,140",
				"to": "00:02:18,900"
			},
			"offsets": {
				"from": 137140,
				"to": 138900
			},
			"text": " Как вы уже знаете, из урока по разделкам договоры предпринимателей,"
		},
		{
			"timestamps": {
				"from": "00:02:18,960",
				"to": "00:02:20,280"
			},
			"offsets": {
				"from": 138960,
				"to": 140280
			},
			"text": " вне зависимости от их суммы, должны быть письменными."
		},
		{
			"timestamps": {
				"from": "00:02:20,380",
				"to": "00:02:22,060"
			},
			"offsets": {
				"from": 140380,
				"to": 142060
			},
			"text": " По закону обязанность по взаимодействию с оператором рекламных данных"
		},
		{
			"timestamps": {
				"from": "00:02:22,060",
				"to": "00:02:23,740"
			},
			"offsets": {
				"from": 142060,
				"to": 143740
			},
			"text": " возложена и на рекламодателя, и на рекламораспространителя."
		},
		{
			"timestamps": {
				"from": "00:02:23,780",
				"to": "00:02:24,600"
			},
			"offsets": {
				"from": 143780,
				"to": 144600
			},
			"text": " А если там есть агенты, то на агент."
		},
		{
			"timestamps": {
				"from": "00:02:24,860",
				"to": "00:02:26,200"
			},
			"offsets": {
				"from": 144860,
				"to": 146200
			},
			"text": " Поэтому целесообразно заранее в договоре прописать,"
		},
		{
			"timestamps": {
				"from": "00:02:26,280",
				"to": "00:02:28,080"
			},
			"offsets": {
				"from": 146280,
				"to": 148080
			},
			"text": " какая сторона будет ответственна за получение токена."
		},
		{
			"timestamps": {
				"from": "00:02:28,340",
				"to": "00:02:29,840"
			},
			"offsets": {
				"from": 148340,
				"to": 149840
			},
			"text": " Многие юристы забывают, но в договоре также важно отразить,"
		},
		{
			"timestamps": {
				"from": "00:02:29,980",
				"to": "00:02:31,660"
			},
			"offsets": {
				"from": 149980,
				"to": 151660
			},
			"text": " кто будет отчитываться за рекламу, потому что если отчета не будет,"
		},
		{
			"timestamps": {
				"from": "00:02:31,840",
				"to": "00:02:33,260"
			},
			"offsets": {
				"from": 151840,
				"to": 153260
			},
			"text": " то штраф получит каждый участник рекламной цепочки."
		},
		{
			"timestamps": {
				"from": "00:02:33,440",
				"to": "00:02:35,680"
			},
			"offsets": {
				"from": 153440,
				"to": 155680
			},
			"text": " 100 тысяч рублей для физлиц, 200 для ИП и 500 тысяч рублей для компании."
		},
		{
			"timestamps": {
				"from": "00:02:35,980",
				"to": "00:02:37,860"
			},
			"offsets": {
				"from": 155980,
				"to": 157860
			},
			"text": " Итак, мы рассмотрели базовые вопросы по маркировке рекламы."
		},
		{
			"timestamps": {
				"from": "00:02:37,860",
				"to": "00:02:39,740"
			},
			"offsets": {
				"from": 157860,
				"to": 159740
			},
			"text": " И теперь настало время разобраться, как же получить рекламный токен."
		}
	]
}
