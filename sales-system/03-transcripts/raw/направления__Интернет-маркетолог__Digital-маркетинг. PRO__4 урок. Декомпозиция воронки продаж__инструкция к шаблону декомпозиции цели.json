				"to": "00:02:21,400"
			},
			"offsets": {
				"from": 138740,
				"to": 141400
			},
			"text": " Это задание я в вышки давал, и вы тоже с ним легко справитесь"
		},
		{
			"timestamps": {
				"from": "00:02:21,400",
				"to": "00:02:23,880"
			},
			"offsets": {
				"from": 141400,
				"to": 143880
			},
			"text": " Сейчас давайте на эту тему немножко гипотезировать"
		},
		{
			"timestamps": {
				"from": "00:02:23,880",
				"to": "00:02:25,740"
			},
			"offsets": {
				"from": 143880,
				"to": 145740
			},
			"text": " Опять же, инструмент декомпозиции нам нужен для чего?"
		},
		{
			"timestamps": {
				"from": "00:02:25,820",
				"to": "00:02:27,060"
			},
			"offsets": {
				"from": 145820,
				"to": 147060
			},
			"text": " Для того, чтобы выставить гипотезу"
		},
		{
			"timestamps": {
				"from": "00:02:27,060",
				"to": "00:02:28,640"
			},
			"offsets": {
				"from": 147060,
				"to": 148640
			},
			"text": " И потом сравнить, мы попали в план или не попали"
		},
		{
			"timestamps": {
				"from": "00:02:28,640",
				"to": "00:02:30,820"
			},
			"offsets": {
				"from": 148640,
				"to": 150820
			},
			"text": " И с опытом ваши гипотезы будут все более-более точными"
		},
		{
			"timestamps": {
				"from": "00:02:30,820",
				"to": "00:02:33,580"
			},
			"offsets": {
				"from": 150820,
				"to": 153580
			},
			"text": " Но если вы никаких гипотез не ставили, вы там хоть сайт запустили, хоть рекламу запустили"
		},
		{
			"timestamps": {
				"from": "00:02:33,580",
				"to": "00:02:36,260"
			},
			"offsets": {
				"from": 153580,
				"to": 156260
			},
			"text": " И как бы, что получилось, что получилось, да, пошли делать следующий проект"
		},
		{
			"timestamps": {
				"from": "00:02:36,260",
				"to": "00:02:38,420"
			},
			"offsets": {
				"from": 156260,
				"to": 158420
			},
			"text": " То есть вы никаких выводов значительных не сделали"
		},
		{
			"timestamps": {
				"from": "00:02:38,420",
				"to": "00:02:39,600"
			},
			"offsets": {
				"from": 158420,
				"to": 159600
			},
			"text": " А что отличает профессионала?"
		},
		{
			"timestamps": {
				"from": "00:02:39,860",
				"to": "00:02:41,900"
			},
			"offsets": {
				"from": 159860,
				"to": 161900
			},
			"text": " Профессионал как бы изначально видит проект, полетит, не полетит"
		},
		{
			"timestamps": {
				"from": "00:02:41,900",
				"to": "00:02:43,160"
			},
			"offsets": {
				"from": 161900,
				"to": 163160
			},
			"text": " И он как бы с конца мыслит"
		},
		{
			"timestamps": {
				"from": "00:02:43,160",
				"to": "00:02:46,280"
			},
			"offsets": {
				"from": 163160,
				"to": 166280
			},
			"text": " С конца, вот когда все получилось, это вот такие показатели нам приносит"
		},
		{
			"timestamps": {
				"from": "00:02:46,280",
				"to": "00:02:48,000"
			},
			"offsets": {
				"from": 166280,
				"to": 168000
			},
			"text": " А чтобы эти показатели нам принесло, нужно тут подкрутить, тут подкрутить"
		},
		{
			"timestamps": {
				"from": "00:02:48,000",
				"to": "00:02:48,940"
			},
			"offsets": {
				"from": 168000,
				"to": 168940
			},
			"text": " Вот тут особое внимание уделить"
		},
		{
			"timestamps": {
				"from": "00:02:48,940",
				"to": "00:02:51,480"
			},
			"offsets": {
				"from": 168940,
				"to": 171480
			},
			"text": " А вот тут проблемная зона, например, да, скорее всего не факт, что выйдет"
		},
		{
			"timestamps": {
				"from": "00:02:51,480",
				"to": "00:02:53,280"
			},
			"offsets": {
				"from": 171480,
				"to": 173280
			},
			"text": " Давайте думать, где еще мы можем откомпенсировать, понимаете?"
		},
		{
			"timestamps": {
				"from": "00:02:53,760",
				"to": "00:02:55,700"
			},
			"offsets": {
				"from": 173760,
				"to": 175700
			},
			"text": " Новичок, он думает как, так, блин, я сейчас, он думает действиями"
		},
		{
			"timestamps": {
				"from": "00:02:55,700",
				"to": "00:02:56,960"
			},
			"offsets": {
				"from": 175700,
				"to": 176960
			},
			"text": " Он не думает целью, он думает действиями"
		},
		{
			"timestamps": {
				"from": "00:02:56,960",
				"to": "00:02:58,080"
			},
			"offsets": {
				"from": 176960,
				"to": 178080
			},
			"text": " Я сделаю рекламу, сделаю сайт"
		},
		{
			"timestamps": {
				"from": "00:02:58,080",
				"to": "00:02:59,980"
			},
			"offsets": {
				"from": 178080,
				"to": 179980
			},
			"text": " А там может быть вообще неокупаемая история"
		},
		{
			"timestamps": {
				"from": "00:02:59,980",
				"to": "00:03:02,340"
			},
			"offsets": {
				"from": 179980,
				"to": 182340
			},
			"text": " И это изначально, из точки А, не имело никакого смысла делать"
		},
		{
			"timestamps": {
				"from": "00:03:02,340",
				"to": "00:03:04,780"
			},
			"offsets": {
				"from": 182340,
				"to": 184780
			},
			"text": " Я вам хочу, чтобы вы были профессиональными"
		},
		{
			"timestamps": {
				"from": "00:03:04,780",
				"to": "00:03:05,720"
			},
			"offsets": {
				"from": 184780,
				"to": 185720
			},
			"text": " Были на рынке, это стоит гораздо больше"
		},
		{
			"timestamps": {
				"from": "00:03:05,720",
				"to": "00:03:07,140"
			},
			"offsets": {
				"from": 185720,
				"to": 187140
			},
			"text": " Мне сегодня один из действующих клиентов нашего агентства написал"
		},
		{
			"timestamps": {
				"from": "00:03:07,140",
				"to": "00:03:08,460"
			},
			"offsets": {
				"from": 187140,
				"to": 188460
			},
			"text": " Володя, дай мне, маркетолога в штат я хочу забрать"
		},
		{
			"timestamps": {
				"from": "00:03:08,460",
				"to": "00:03:11,160"
			},
			"offsets": {
				"from": 188460,
				"to": 191160
			},
			"text": " И вот для того, чтобы вы могли как бы давать классный продукт на рынке"
		},
		{
			"timestamps": {
				"from": "00:03:11,160",
				"to": "00:03:13,680"
			},
			"offsets": {
				"from": 191160,
				"to": 193680
			},
			"text": " Мы делаем из вас профессионалов, а профессионал всегда считает определенные гипотезы"
		},
		{
			"timestamps": {
				"from": "00:03:13,680",
				"to": "00:03:16,100"
			},
			"offsets": {
				"from": 193680,
				"to": 196100
			},
			"text": " Где брать расчетные данные?"
		},
		{
			"timestamps": {
				"from": "00:03:16,420",
				"to": "00:03:17,460"
			},
			"offsets": {
				"from": 196420,
				"to": 197460
			},
			"text": " Болт забейте сейчас на это"
		},
		{
			"timestamps": {
				"from": "00:03:17,460",
				"to": "00:03:19,300"
			},
			"offsets": {
				"from": 197460,
				"to": 199300
			},
			"text": " Реально, вот ваша задача вот так вот брать данные"
		},
		{
			"timestamps": {
				"from": "00:03:19,300",
				"to": "00:03:21,080"
			},
			"offsets": {
				"from": 199300,
				"to": 201080
			},
			"text": " Вот ветер туда сдует, напишу полтора процента"
		},
		{
			"timestamps": {
				"from": "00:03:21,080",
				"to": "00:03:23,660"
			},
			"offsets": {
				"from": 201080,
				"to": 203660
			},
			"text": " По-другому сейчас на вашем уровне"
		},
		{
			"timestamps": {
				"from": "00:03:23,660",
				"to": "00:03:25,160"
			},
			"offsets": {
				"from": 203660,
				"to": 205160
			},
			"text": " Пока вы это все своими ручками не запускали, никак"
		},
		{
			"timestamps": {
				"from": "00:03:25,160",
				"to": "00:03:26,320"
			},
			"offsets": {
				"from": 205160,
				"to": 206320
			},
			"text": " Если есть куратор, можно у него спросить"
		},
		{
			"timestamps": {
				"from": "00:03:26,320",
				"to": "00:03:27,660"
			},
			"offsets": {
				"from": 206320,
				"to": 207660
			},
			"text": " Какая у меня цена клик адекватной в моей нише"
		},
		{
			"timestamps": {
				"from": "00:03:27,660",
				"to": "00:03:31,200"
			},
			"offsets": {
				"from": 207660,
				"to": 211200
			},
			"text": " Но задача этого упражнения в том, чтобы у вас в голове возникла полочка"
		},
		{
			"timestamps": {
				"from": "00:03:31,200",
				"to": "00:03:32,540"
			},
			"offsets": {
				"from": 211200,
				"to": 212540
			},
			"text": " Специально полочка для данных"
		},
		{
			"timestamps": {
				"from": "00:03:32,540",
				"to": "00:03:33,640"
			},
			"offsets": {
				"from": 212540,
				"to": 213640
			},
			"text": " Потому что когда вы встретитесь с реальностью"
		},
		{
			"timestamps": {
				"from": "00:03:33,640",
				"to": "00:03:35,460"
			},
			"offsets": {
				"from": 213640,
				"to": 215460
			},
			"text": " Когда вы эти данные глазками увидите"
		},
		{
			"timestamps": {
				"from": "00:03:35,460",
				"to": "00:03:36,580"
			},
			"offsets": {
				"from": 215460,
				"to": 216580
			},
			"text": " Где-нибудь в рекламных каналах"
		},
		{
			"timestamps": {
				"from": "00:03:36,580",
				"to": "00:03:37,980"
			},
			"offsets": {
				"from": 216580,
				"to": 217980
			},
			"text": " Или на каком-то разборе сайта или еще что-то"
		},
		{
			"timestamps": {
				"from": "00:03:37,980",
				"to": "00:03:39,580"
			},
			"offsets": {
				"from": 217980,
				"to": 219580
			},
			"text": " У вас в эту полочку эти данные подставятся"
		},
		{
			"timestamps": {
				"from": "00:03:39,580",
				"to": "00:03:40,780"
			},
			"offsets": {
				"from": 219580,
				"to": 220780
			},
			"text": " То есть если вы это упражнение не сделали"
		},
		{
			"timestamps": {
				"from": "00:03:40,780",
				"to": "00:03:41,880"
			},
			"offsets": {
				"from": 220780,
				"to": 221880
			},
			"text": " То этих полочек просто не возникнет"
		},
		{
			"timestamps": {
				"from": "00:03:41,880",
				"to": "00:03:43,240"
			},
			"offsets": {
				"from": 221880,
				"to": 223240
			},
			"text": " Поэтому вы сюда пишите какие-то штуковины"
		},
		{
			"timestamps": {
				"from": "00:03:43,240",
				"to": "00:03:44,360"
			},
			"offsets": {
				"from": 223240,
				"to": 224360
			},
			"text": " Упражнение очень несложное"
		},
		{
			"timestamps": {
				"from": "00:03:44,360",
				"to": "00:03:47,060"
			},
			"offsets": {
				"from": 224360,
				"to": 227060
			},
			"text": " Как у меня студенты в высшей школе экономики"
		},
		{
			"timestamps": {
				"from": "00:03:47,060",
				"to": "00:03:47,720"
			},
			"offsets": {
				"from": 227060,
				"to": 227720
			},
			"text": " Отвечали, они просто такие"
		},
		{
			"timestamps": {
				"from": "00:03:47,720",
				"to": "00:03:50,440"
			},
			"offsets": {
				"from": 227720,
				"to": 230440
			},
			"text": " Так, мы взяли консультацию топового директолога в этой нише"
		},
		{
			"timestamps": {
				"from": "00:03:50,440",
				"to": "00:03:52,000"
			},
			"offsets": {
				"from": 230440,
				"to": 232000
			},
			"text": " Он нам показал, как сделать цену клика 90 рублей"
		},
		{
			"timestamps": {
				"from": "00:03:52,000",
				"to": "00:03:54,860"
			},
			"offsets": {
				"from": 232000,
				"to": 234860
			},
			"text": " Можете там плюс-минус 15% эти показатели смотреть"
		},
		{
			"timestamps": {
				"from": "00:03:54,860",
				"to": "00:03:56,160"
			},
			"offsets": {
				"from": 234860,
				"to": 236160
			},
			"text": " Мы посмотрели модуль по сайтам"
		},
		{
			"timestamps": {
				"from": "00:03:56,160",
				"to": "00:03:57,520"
			},
			"offsets": {
				"from": 236160,
				"to": 237520
			},
			"text": " Внедрили передовые техники Владимира Сургая"
		},
		{
			"timestamps": {
				"from": "00:03:57,520",
				"to": "00:03:58,940"
			},
			"offsets": {
				"from": 237520,
				"to": 238940
			},
			"text": " И у нас конверсия стала 6%, а не 4"
		},
		{
			"timestamps": {
				"from": "00:03:58,940",
				"to": "00:04:00,620"
			},
			"offsets": {
				"from": 238940,
				"to": 240620
			},
			"text": " Внедрили мультиквизы какие-нибудь"
		},
		{
			"timestamps": {
				"from": "00:04:00,620",
				"to": "00:04:03,500"
			},
			"offsets": {
				"from": 240620,
				"to": 243500
			},
			"text": " Сделали какую-нибудь вескую причину, чтобы человек доезжал до встречи"
		},
		{
			"timestamps": {
				"from": "00:04:03,500",
				"to": "00:04:04,920"
			},
			"offsets": {
				"from": 243500,
				"to": 244920
			},
			"text": " Добавили им какой-нибудь бизнес-такси до офиса"
		},
		{
			"timestamps": {
				"from": "00:04:04,920",
				"to": "00:04:05,620"
			},
			"offsets": {
				"from": 244920,
				"to": 245620
			},
			"text": " Стало 35%"
		},
		{
			"timestamps": {
				"from": "00:04:05,620",
				"to": "00:04:07,640"
			},
			"offsets": {
				"from": 245620,
				"to": 247640
			},
			"text": " Вот, прошли какой-нибудь день по продажам в Москве"
		},
		{
			"timestamps": {
				"from": "00:04:07,640",
				"to": "00:04:09,640"
			},
			"offsets": {
				"from": 247640,
				"to": 249640
			},
			"text": " В ноябре, в декабре с Александром Кучеренко и Владимиром Сургаем"
		},
		{
			"timestamps": {
				"from": "00:04:09,640",
				"to": "00:04:10,540"
			},
			"offsets": {
				"from": 249640,
				"to": 250540
			},
			"text": " Научились круто продавать"
		},
		{
			"timestamps": {
				"from": "00:04:10,540",
				"to": "00:04:12,140"
			},
			"offsets": {
				"from": 250540,
				"to": 252140
			},
			"text": " Взяли скрипт, который принялся уже больше 100 миллионов рублей"
		},
		{
			"timestamps": {
				"from": "00:04:12,140",
				"to": "00:04:13,640"
			},
			"offsets": {
				"from": 252140,
				"to": 253640
			},
			"text": " Стало конверсия 16% в сделку"
		},
		{
			"timestamps": {
				"from": "00:04:13,640",
				"to": "00:04:15,340"
			},
			"offsets": {
				"from": 253640,
				"to": 255340
			},
			"text": " Вот, таким образом получили 29 заказов"
		},
		{
			"timestamps": {
				"from": "00:04:15,340",
				"to": "00:04:16,860"
			},
			"offsets": {
				"from": 255340,
				"to": 256860
			},
			"text": " И тут, не знаю, может быть, средний чек подняли"
		},
		{
			"timestamps": {
				"from": "00:04:16,860",
				"to": "00:04:17,960"
			},
			"offsets": {
				"from": 256860,
				"to": 257960
			},
			"text": " Поняли, что можно продавать подороже"
