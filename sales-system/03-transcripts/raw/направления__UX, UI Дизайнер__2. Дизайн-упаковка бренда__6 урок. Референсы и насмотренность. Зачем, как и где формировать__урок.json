				"to": 136040
			},
			"text": " И как я уже говорила, мудборд — это набор референсов на определённую тематику, собранный в одном месте"
		},
		{
			"timestamps": {
				"from": "00:02:16,040",
				"to": "00:02:18,200"
			},
			"offsets": {
				"from": 136040,
				"to": 138200
			},
			"text": " Где и как вы будете его собирать, решать вам"
		},
		{
			"timestamps": {
				"from": "00:02:18,200",
				"to": "00:02:19,580"
			},
			"offsets": {
				"from": 138200,
				"to": 139580
			},
			"text": " Я бы для этого посоветовала использовать Pinterest"
		},
		{
			"timestamps": {
				"from": "00:02:19,580",
				"to": "00:02:21,460"
			},
			"offsets": {
				"from": 139580,
				"to": 141460
			},
			"text": " Создать новую доску Figma, на которой собирать именно свои примеры"
		},
		{
			"timestamps": {
				"from": "00:02:21,460",
				"to": "00:02:23,160"
			},
			"offsets": {
				"from": 141460,
				"to": 143160
			},
			"text": " Если вы нашли их не только на Pinterest, но и на каких-то других сервисах"
		},
		{
			"timestamps": {
				"from": "00:02:23,160",
				"to": "00:02:25,020"
			},
			"offsets": {
				"from": 143160,
				"to": 145020
			},
			"text": " Service Behance, например, тоже предлагает создавать свои сохранёнки"
		},
		{
			"timestamps": {
				"from": "00:02:25,020",
				"to": "00:02:28,280"
			},
			"offsets": {
				"from": 145020,
				"to": 148280
			},
			"text": " Но я лично по проекту, если я создаю мудборд по проекту, я люблю создавать его именно на той доске Figma"
		},
		{
			"timestamps": {
				"from": "00:02:28,280",
				"to": "00:02:30,820"
			},
			"offsets": {
				"from": 148280,
				"to": 150820
			},
			"text": " В которой я буду создавать дизайн всего проекта, чтобы референсы были под рукой"
		},
		{
			"timestamps": {
				"from": "00:02:30,820",
				"to": "00:02:33,240"
			},
			"offsets": {
				"from": 150820,
				"to": 153240
			},
			"text": " Получается, неважно, на каком сервисе я нашла референс, я его сохраняю к себе на компьютер"
		},
		{
			"timestamps": {
				"from": "00:02:33,240",
				"to": "00:02:34,680"
			},
			"offsets": {
				"from": 153240,
				"to": 154680
			},
			"text": " И из компьютера уже переношу в Figma"
		},
		{
			"timestamps": {
				"from": "00:02:34,680",
				"to": "00:02:36,700"
			},
			"offsets": {
				"from": 154680,
				"to": 156700
			},
			"text": " Если вы сохраняете какие-то мудборды себе на будущее"
		},
		{
			"timestamps": {
				"from": "00:02:36,700",
				"to": "00:02:39,140"
			},
			"offsets": {
				"from": 156700,
				"to": 159140
			},
			"text": " Я, как старовер, очень сильно люблю сохранять всё в папчиках на компьютере"
		},
		{
			"timestamps": {
				"from": "00:02:39,140",
				"to": "00:02:41,140"
			},
			"offsets": {
				"from": 159140,
				"to": 161140
			},
			"text": " Можно использовать для этого Notion, о котором я вам уже рассказывала"
		},
		{
			"timestamps": {
				"from": "00:02:41,140",
				"to": "00:02:42,560"
			},
			"offsets": {
				"from": 161140,
				"to": 162560
			},
			"text": " Или какие-то другие сервисы с заметками"
		},
		{
			"timestamps": {
				"from": "00:02:42,560",
				"to": "00:02:45,140"
			},
			"offsets": {
				"from": 162560,
				"to": 165140
			},
			"text": " А можно ли как-то понять, какой референс хороший, а какой референс плохой?"
		},
		{
			"timestamps": {
				"from": "00:02:45,360",
				"to": "00:02:45,540"
			},
			"offsets": {
				"from": 165360,
				"to": 165540
			},
			"text": " Можно"
		},
		{
			"timestamps": {
				"from": "00:02:45,540",
				"to": "00:02:47,260"
			},
			"offsets": {
				"from": 165540,
				"to": 167260
			},
			"text": " Есть основные маркеры, по которым вы можете определить"
		},
		{
			"timestamps": {
				"from": "00:02:47,260",
				"to": "00:02:48,920"
			},
			"offsets": {
				"from": 167260,
				"to": 168920
			},
			"text": " Во-первых, референсы должны быть подходящего стиля"
		},
		{
			"timestamps": {
				"from": "00:02:48,920",
				"to": "00:02:52,140"
			},
			"offsets": {
				"from": 168920,
				"to": 172140
			},
			"text": " Если вы делаете дизайн для какой-то команды разработчиков, айтишников"
		},
		{
			"timestamps": {
				"from": "00:02:52,140",
				"to": "00:02:56,020"
			},
			"offsets": {
				"from": 172140,
				"to": 176020
			},
			"text": " То, разумеется, вряд ли вам подойдёт дизайн из мультиков про принцесс"
		},
		{
			"timestamps": {
				"from": "00:02:56,020",
				"to": "00:03:00,380"
			},
			"offsets": {
				"from": 176020,
				"to": 180380
			},
			"text": " Или, если вы создаете дизайн для цветочного магазина, вряд ли вам подойдёт шрифт, как у Майнкрафта"
		},
		{
			"timestamps": {
				"from": "00:03:00,380",
				"to": "00:03:01,860"
			},
			"offsets": {
				"from": 180380,
				"to": 181860
			},
			"text": " Следующий маркер — это качество исполнения референса"
		},
		{
			"timestamps": {
				"from": "00:03:01,860",
				"to": "00:03:04,400"
			},
			"offsets": {
				"from": 181860,
				"to": 184400
			},
			"text": " Разумеется, вдохновляться можно от всего, что угодно"
		},
		{
			"timestamps": {
				"from": "00:03:04,400",
				"to": "00:03:09,160"
			},
			"offsets": {
				"from": 184400,
				"to": 189160
			},
			"text": " Можно вдохновиться от детского рисунка, потому что в детском рисунке будет какая-то зацепочка или ассоциация, которая вызвала у вас классную идею или мысль"
		},
		{
			"timestamps": {
				"from": "00:03:09,160",
				"to": "00:03:13,600"
			},
			"offsets": {
				"from": 189160,
				"to": 193600
			},
			"text": " Но всё-таки чаще всего, если вы ищете референсы, важно, чтобы они были именно качественно выполнены, в хорошем разрешении"
		},
		{
			"timestamps": {
				"from": "00:03:13,600",
				"to": "00:03:15,660"
			},
			"offsets": {
				"from": 193600,
				"to": 195660
			},
			"text": " Чтобы была хорошая подборка цветов"
		},
		{
			"timestamps": {
				"from": "00:03:15,660",
				"to": "00:03:17,260"
			},
			"offsets": {
				"from": 195660,
				"to": 197260
			},
			"text": " И было видно, что этот референс выполнил профессионал"
		},
		{
			"timestamps": {
				"from": "00:03:17,260",
				"to": "00:03:18,920"
			},
			"offsets": {
				"from": 197260,
				"to": 198920
			},
			"text": " Вы уже знаете про правильное сочетание цветов и композицию"
		},
		{
			"timestamps": {
				"from": "00:03:18,920",
				"to": "00:03:21,760"
			},
			"offsets": {
				"from": 198920,
				"to": 201760
			},
			"text": " И, думаю, вы сразу увидите референс, на котором композиция сделана плохо"
		},
		{
			"timestamps": {
				"from": "00:03:21,760",
				"to": "00:03:25,020"
			},
			"offsets": {
				"from": 201760,
				"to": 205020
			},
			"text": " Или какой-то девятант подбирал цвета, используется грязных цветов много или слишком много ярких"
		},
		{
			"timestamps": {
				"from": "00:03:25,020",
				"to": "00:03:27,960"
			},
			"offsets": {
				"from": 205020,
				"to": 207960
			},
			"text": " И уже поймёт, что на такой референс лучше не опираться и скорее от него уйти подальше"
		},
		{
			"timestamps": {
				"from": "00:03:27,960",
				"to": "00:03:30,200"
			},
			"offsets": {
				"from": 207960,
				"to": 210200
			},
			"text": " Референс будет хорошим, если его идея и концепция вас вдохновляют"
		},
		{
			"timestamps": {
				"from": "00:03:30,200",
				"to": "00:03:31,700"
			},
			"offsets": {
				"from": 210200,
				"to": 211700
			},
			"text": " Если вы смотрите на картинку, пусть она будет качественная"
		},
		{
			"timestamps": {
				"from": "00:03:31,700",
				"to": "00:03:36,640"
			},
			"offsets": {
				"from": 211700,
				"to": 216640
			},
			"text": " Пусть она будет подходить вам по тематике, но вы на неё смотрите и не понимаете, как вообще, что это может быть в вашем проекте"
		},
		{
			"timestamps": {
				"from": "00:03:36,640",
				"to": "00:03:38,360"
			},
			"offsets": {
				"from": 216640,
				"to": 218360
			},
			"text": " Какая часть этого референса может, например, найти свое отражение в проекте"
		},
		{
			"timestamps": {
				"from": "00:03:38,360",
				"to": "00:03:40,440"
			},
			"offsets": {
				"from": 218360,
				"to": 220440
			},
			"text": " Или если она, в принципе, вас не вдохновляет, то этот непохидачный референс"
		},
		{
			"timestamps": {
				"from": "00:03:40,440",
				"to": "00:03:41,440"
			},
			"offsets": {
				"from": 220440,
				"to": 221440
			},
			"text": " Его можно пропустить и не использовать"
		},
		{
			"timestamps": {
				"from": "00:03:41,440",
				"to": "00:03:44,140"
			},
			"offsets": {
				"from": 221440,
				"to": 224140
			},
			"text": " Потому что основная задача референса — это ваше вдохновение, ваши идеи"
		},
		{
			"timestamps": {
				"from": "00:03:44,140",
				"to": "00:03:46,100"
			},
			"offsets": {
				"from": 224140,
				"to": 226100
			},
			"text": " Которые, если они не появились, то этот референс не работает"
		},
		{
			"timestamps": {
				"from": "00:03:46,100",
				"to": "00:03:46,960"
			},
			"offsets": {
				"from": 226100,
				"to": 226960
			},
			"text": " Ну и, конечно же, оригинальность"
		},
		{
			"timestamps": {
				"from": "00:03:46,960",
				"to": "00:03:47,900"
			},
			"offsets": {
				"from": 226960,
				"to": 227900
			},
			"text": " Референс должен быть уникальным"
		},
		{
			"timestamps": {
				"from": "00:03:47,900",
				"to": "00:03:50,040"
			},
			"offsets": {
				"from": 227900,
				"to": 230040
			},
			"text": " Если вы видели в подобном стиле подобные сюжеты"
		},
		{
			"timestamps": {
				"from": "00:03:50,040",
				"to": "00:03:52,920"
			},
			"offsets": {
				"from": 230040,
				"to": 232920
			},
			"text": " Такое же там изображение или похожий логотип много-много-много-много раз"
		},
		{
			"timestamps": {
				"from": "00:03:52,920",
				"to": "00:03:54,940"
			},
			"offsets": {
				"from": 232920,
				"to": 234940
			},
			"text": " То вряд ли вы хотите создать ещё один такой же один из многих"
		},
		{
			"timestamps": {
				"from": "00:03:54,940",
				"to": "00:03:56,300"
			},
			"offsets": {
				"from": 234940,
				"to": 236300
			},
			"text": " Тогда и этот референс вам не нужен"
		}
	]
}
