		{
			"timestamps": {
				"from": "00:01:23,960",
				"to": "00:01:25,460"
			},
			"offsets": {
				"from": 83960,
				"to": 85460
			},
			"text": " и успешно ее копирует компания Xiaomi,"
		},
		{
			"timestamps": {
